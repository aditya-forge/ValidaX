# Normalise text files to LF in the repository.
* text=auto eol=lf

# Shell scripts and the Dockerfile must stay LF to run inside Linux containers.
*.sh        text eol=lf
Dockerfile  text eol=lf

# Windows-only scripts keep CRLF.
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binary artifacts: never diff or convert.
*.pkl       binary
*.png       binary
*.parquet   binary
