# Keep the build context small and free of data/secrets.
.git
.gitignore
.gitattributes
.github
.venv
venv
**/__pycache__
**/*.py[cod]
**/.ipynb_checkpoints
.pytest_cache
.ruff_cache
.vscode
.idea
.streamlit/secrets.toml

# Kaggle data: never baked into the image (mount data/processed at runtime instead)
data/

# Not needed at runtime
notebooks/
tests/
sql/
requirements.txt
pyproject.toml
Makefile
.editorconfig
*.md
Dockerfile
.dockerignore
