# Kaggle data: redistribution is not allowed under the competition rules.
# Keep only the empty folders (via .gitkeep) so the expected layout exists.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.parquet
*.csv.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml
.streamlit/credentials.toml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
